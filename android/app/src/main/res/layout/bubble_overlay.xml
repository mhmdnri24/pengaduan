<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_container"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical"
    android:background="#222222ED"
    android:padding="18dp"
    android:elevation="18dp"
    android:clipToPadding="false"
    android:minWidth="300dp"
    android:minHeight="420dp"
    android:gravity="center"
    android:backgroundTintMode="src_atop"
    android:backgroundTint="#181818">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <!-- Title -->
        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="INFORMASI DARURAT"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:gravity="center" />

        <!-- Close -->
        <ImageView
            android:id="@+id/bubble_close"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/close_button_background_blue"
            android:tint="@android:color/white"
            android:padding="6dp"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Icon GIF Emergency -->
    <ImageView
        android:id="@+id/emergency_icon"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginBottom="14dp"
        android:src="@drawable/panic"
        android:contentDescription="Emergency icon"
        android:background="@drawable/emergency_icon_background"
        android:padding="14dp" />

    <!-- Complaint Card -->
    <LinearLayout
        android:id="@+id/complaint_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#ff003378"
        android:padding="14dp"
        android:backgroundTint="#ff003311"
        android:layout_marginBottom="10dp"
        android:elevation="6dp"
        android:backgroundTintMode="src_atop">

        <TextView
            android:id="@+id/complaint_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pengaduan Baru"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:id="@+id/complaint_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#ffcccc"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/complaint_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#ffdddd"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/complaint_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#ffdddd"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/complaint_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#ffdddd"
            android:textSize="13sp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Map View -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="10dp"
        android:layout_marginTop="6dp"
        android:elevation="4dp" />

    <!-- Badge (Jumlah Masuk) -->
    <TextView
        android:id="@+id/badge_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="0"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="#ff4d6d"
        android:minWidth="30dp"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        android:elevation="4dp" />

    <!-- Footer Button -->
    <TextView
        android:id="@+id/bubble_open"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="#ff0033"
        android:gravity="center"
        android:text="Buka Pengaduan"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.03"
        android:includeFontPadding="false"
        android:elevation="12dp" />

</LinearLayout>
